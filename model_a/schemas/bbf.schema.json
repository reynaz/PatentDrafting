                "required": [
                  "tur",
                  "ad",
                  "islev",
                  "yeni",
                  "zorunlu"
                ],
                "properties": {
                  "tur": {
                    "type": "string",
                    "enum": [
                      "parca",
                      "adim",
                      "bilesen"
                    ],
                    "description": "parca: fiziksel bileşen (gövde, valf) | adim: sırayla yapılan işlem | bilesen: karışımın içeriği"
                  },
                  "ad": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unsurun adı. Belge boyunca AYNI ad kullanılmalı (terim sözlüğü)."
                  },
                  "islev": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unsurun buluştaki görevi; buluşçu dilinde, 1-2 cümle"
                  },
                  "yeni": {
                    "type": "boolean",
                    "description": "true: önceki teknikte yok, buluşun yenilik getiren kısmı"
                  },
                  "zorunlu": {
                    "type": "boolean",
                    "description": "true: çıkarılırsa buluş çalışmaz (bağımsız isteme aday) | false: çıkarılsa da buluş işler (bağımlı isteme aday)"
                  },
                  "sira": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "description": "Yalnızca tur=adim için zorunlu: işlem sırası"
                  },
                  "kosul": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Sayısal değer/aralık/koşul: '120-150 °C, 30 dk' (adım), 'ağırlıkça %60-70' (bileşen), '0,2-0,5 mm' (parça). Uydurma; yoksa null"
                  },
                  "baglantilar": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "tur=parca için: bağlı/etkileştiği diğer unsurların adları"
                  }
                }
