{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://istem-proje/schemas/bbf.schema.json",
  "title": "Kanonik Buluş Bildirim Formu (BBF)",
  "description": "Sürüm 0.1. Model A çıktısı, normalizer çıktısı ve Model B girdisi bu şemaya uyar. Kişisel/idari/ticari bilgi içermez. İstem dili ('…ile karakterize edilmektedir') ve şekil referans numaraları ('gövde (1)') kullanılmaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sema_surumu",
    "baslik",
    "bulus_turu",
    "teknik_alan",
    "onceki_teknik",
    "teknik_problem",
    "unsurlar",
    "detayli_aciklama",
    "sekiller",
    "avantajlar"
  ],
  "properties": {
    "sema_surumu": {
      "const": "0.1"
    },
    "baslik": {
      "type": "object",
      "description": "Buluşun kısa ve tanımlayıcı adı; marka içermez.",
      "additionalProperties": false,
      "required": [
        "deger",
        "durum"
      ],
      "properties": {
        "deger": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "durum": {
          "type": "string",
          "enum": [
            "dolu",
            "turetildi",
            "sorulmamis",
            "bos_birakilmis"
          ],
          "description": "dolu: kaynakta doğrudan var | turetildi: başka bir bölümden çıkarıldı (kaynak zorunlu) | sorulmamis: kaynak form bu bilgiyi sormuyor | bos_birakilmis: soruluyor ama boş"
        },
        "kaynak": {
          "type": [
            "string",
            "null"
          ],
          "description": "durum=turetildi ise: bilginin alındığı bölümün adı veya kısa alıntı"
        }
      }
    },
    "bulus_turu": {
      "type": "object",
