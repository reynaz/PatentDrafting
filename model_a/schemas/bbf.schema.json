    "unsurlar": {
      "type": "object",
      "description": "Buluşun çekirdeği: parçalar, adımlar veya bileşenler (tek liste, tur etiketiyle).",
      "additionalProperties": false,
      "required": [
        "deger",
        "durum"
      ],
      "properties": {
        "deger": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
